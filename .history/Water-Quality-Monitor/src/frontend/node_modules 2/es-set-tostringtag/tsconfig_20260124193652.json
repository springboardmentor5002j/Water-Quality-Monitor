{
    "compilerOptions": {
        "target": "es2021",
        "module": "commonjs",
        "lib": ["es2021"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["src/**/*.ts"],
    "exclude": ["coverage", "node_modules"]
}